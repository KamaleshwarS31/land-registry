# ==============================================================================
# Blockchain-Based Land Registration System - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: In-Memory / Dev Mode (Zero-setup H2 database with PostgreSQL compatibility)
SPRING_PROFILES_ACTIVE=dev

# Option B: Supabase PostgreSQL (Full Cloud Database)
# To use Supabase PostgreSQL, set SPRING_PROFILES_ACTIVE=postgres and provide:
# SPRING_PROFILES_ACTIVE=postgres
# DB_URL=jdbc:postgresql://db.<YOUR-PROJECT-REF>.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=<YOUR-SUPABASE-DATABASE-PASSWORD>
# (Or using connection pooling):
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# DB_USERNAME=postgres.<YOUR-PROJECT-REF>
# DB_PASSWORD=<YOUR-SUPABASE-DATABASE-PASSWORD>

# ------------------------------------------------------------------------------
# 2. SUPABASE STORAGE (For Off-Chain Evidence Documents & Deeds)
# ------------------------------------------------------------------------------
# Set STORAGE_PROVIDER=SUPABASE to store evidence files directly in Supabase Storage.
# Leave STORAGE_PROVIDER=LOCAL to store files locally in ./uploads.
STORAGE_PROVIDER=LOCAL
SUPABASE_URL=https://<YOUR-PROJECT-REF>.supabase.co
# IMPORTANT: Use the 'service_role' secret key (Project Settings -> API -> service_role)
SUPABASE_KEY=<YOUR-SUPABASE-SERVICE-ROLE-KEY>
SUPABASE_BUCKET=land-evidence
LOCAL_STORAGE_DIR=./uploads

# ------------------------------------------------------------------------------
# 3. BLOCKCHAIN CONFIGURATION (EVM / Hardhat)
# ------------------------------------------------------------------------------
BLOCKCHAIN_MODE=SIMULATION # Use 'LIVE' for local Hardhat node, 'SIMULATION' for zero-node execution
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
REGISTRAR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ------------------------------------------------------------------------------
# 4. SPRING SECURITY & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
