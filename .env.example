# ==============================================================================
# Blockchain-Based Land Registration System - Environment Configuration
# ==============================================================================

# Database Configuration (Supabase PostgreSQL or Local PostgreSQL)
# For local Docker/PostgreSQL:
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/land_registry
DB_USERNAME=postgres
DB_PASSWORD=postgres

# For Supabase PostgreSQL (uncomment and fill when using Supabase):
# DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# DB_USERNAME=postgres
# DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Supabase Storage Configuration (for off-chain evidence documents)
# Documents are stored privately in this bucket with signed download URLs
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_BUCKET=land-evidence
STORAGE_PROVIDER=LOCAL
LOCAL_STORAGE_DIR=./uploads

# Local EVM Blockchain Configuration (Hardhat)
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Default Hardhat Node Account #0 private key (used for local testing only)
REGISTRAR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Spring Security & JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
